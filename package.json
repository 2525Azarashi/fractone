{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build -c vite.client.config.ts",
    "build": "npm run build:client && vite build",
    "preview": "wrangler pages dev",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}